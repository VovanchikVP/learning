# Подключение к PostgreSQL
CL_PG_DSN=postgresql://user:password@localhost:5432/dbname

# Таблица с размеченными картинками и имена колонок
CL_TABLE=captcha
CL_ID_COLUMN=id
CL_IMAGE_COLUMN=image
CL_ANSWER_COLUMN=answer

# Колонка для поиска новых строк (id — uuid, по нему порядок вставки не виден).
# Колонка обязана существовать в таблице: если её нет, каждый опрос базы
# падает с ошибкой (видно в логах и в /status -> watcher.last_error).
# Рекомендуется указать created_at и иметь индекс (created_at, id).
# Если оставить пустым, сервис будет сверять список id с локальным кэшем.
CL_CURSOR_COLUMN=created_at

# Где хранить кэш картинок, чекпоинты и состояние
CL_WORKDIR=var

# cpu | mps | cuda | auto
CL_DEVICE=auto

# Сколько новых строк в группе запускают дообучение
CL_RETRAIN_THRESHOLD=100

# Как часто опрашивать базу, секунды
CL_POLL_INTERVAL=5

# DEBUG показывает в том числе строки, отсеянные фильтром приёма
CL_LOG_LEVEL=INFO

CL_API_HOST=127.0.0.1
CL_API_PORT=8000
